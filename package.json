{
  "name": "meta-gestao-veicular",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && pnpm --dir api typecheck && pnpm --dir functions typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:build": "pnpm --dir api build",
    "api:test": "pnpm --dir api test",
    "functions:build": "pnpm --dir functions build",
    "functions:test": "pnpm --dir functions test",
    "firebase:deploy": "firebase deploy --project gestaoveicular-47777",
    "build:all": "pnpm build && pnpm api:build && pnpm functions:build",
    "test:all": "pnpm test && pnpm api:test && pnpm functions:test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2",
    "firebase": "12.18.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "firebase-tools": "^15.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
