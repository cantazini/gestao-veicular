# Copie para .env.local. Nunca faça commit do arquivo real.
# Este arquivo pertence somente ao React. Não coloque connection strings ou chaves Azure aqui.
# SQL_CONNECTION_STRING e AZURE_STORAGE_CONNECTION_STRING pertencem exclusivamente à API.
VITE_API_BASE_URL=/api

# Desenvolvimento local explícito. Nunca habilitar no build de produção.
VITE_DEV_AUTH=false
VITE_DEV_API=false
VITE_DEV_ROLE=admin
