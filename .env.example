# Copie para .env.local. Nunca faça commit do arquivo real.
# Este arquivo pertence somente ao React. Não coloque connection strings ou chaves Azure aqui.
# SQL_CONNECTION_STRING e AZURE_STORAGE_CONNECTION_STRING pertencem exclusivamente à API.
VITE_API_BASE_URL=/api

# Desenvolvimento local explícito. Nunca habilitar no build de produção.
VITE_DEV_AUTH=false
VITE_DEV_API=false
VITE_DEV_ROLE=admin

# Provedor principal. Use "azure" somente para acionar o fallback legado.
VITE_DATA_BACKEND=firebase
VITE_AUTH_PROVIDER=firebase

# Configuração pública do Firebase Web App já existente.
# Estes valores identificam o app Web; não são credenciais administrativas.
VITE_FIREBASE_API_KEY=COLE_A_API_KEY_DO_FIREBASE_WEB_APP
VITE_FIREBASE_AUTH_DOMAIN=gestaoveicular-47777.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gestaoveicular-47777
VITE_FIREBASE_STORAGE_BUCKET=COLE_O_NOME_EXATO_DO_BUCKET_ADICIONAL_DE_SAO_PAULO
VITE_FIREBASE_MESSAGING_SENDER_ID=COLE_O_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=COLE_O_APP_ID

# Opcional nesta etapa. Só informe depois de cadastrar uma chave reCAPTCHA Enterprise.
VITE_FIREBASE_APPCHECK_SITE_KEY=
