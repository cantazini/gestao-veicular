rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regra segura para produção: o acesso exige autenticação.
    // A primeira versão da interface ainda não possui tela de login, portanto
    // mantenha o Modo local ou use somente um projeto isolado de desenvolvimento.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

